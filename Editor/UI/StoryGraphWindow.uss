/* =============================================================================
 * StoryGraphWindow.uss — 主窗口布局与面板（02 §4.1）
 * 主窗口所有样式收口于此；颜色优先引用主题层变量 --c-*（见 StoryEditorTheme.uss），
 * 少数「深色控制台」语义色（与明暗主题无关的暗底）直接写死。
 * 通用间距用工具类（.sgw-mt* / .sgw-ml* / .sgw-mr* 等），避免 C# 里散落 margin 赋值。
 * ========================================================================== */

.sgw-root { flex-direction: column; }

/* ── 布局工具类 ── */
.sgw-col { flex-direction: column; }
.sgw-row { flex-direction: row; }
.sgw-row-center { flex-direction: row; align-items: center; }
.sgw-grow { flex-grow: 1; }
.sgw-shrink0 { flex-shrink: 0; }
.sgw-spacer { flex-grow: 1; }

/* 按钮通用字号 */
.sgw-btn { font-size: 11px; }

/* 间距工具类 */
.sgw-mt2 { margin-top: 2px; }
.sgw-mt3 { margin-top: 3px; }
.sgw-mt4 { margin-top: 4px; }
.sgw-mt5 { margin-top: 5px; }
.sgw-mt6 { margin-top: 6px; }
.sgw-mt8 { margin-top: 8px; }
.sgw-mb5 { margin-bottom: 5px; }
.sgw-ml2 { margin-left: 2px; }
.sgw-ml4 { margin-left: 4px; }
.sgw-ml6 { margin-left: 6px; }
.sgw-ml8 { margin-left: 8px; }
.sgw-mr4 { margin-right: 4px; }
.sgw-mr6 { margin-right: 6px; }
.sgw-mlr6 { margin-left: 6px; margin-right: 6px; }
.sgw-pl6 { padding-left: 6px; }

/* ── 工具栏 ── */
.sgw-tool-btn { margin-left: 8px; }
.sgw-search { width: 160px; margin-left: 8px; }
.sgw-search-result { font-size: 10px; color: rgb(128, 128, 128); margin-left: 4px; }
.sgw-status { -unity-font-style: italic; padding-left: 6px; }

/* ── 主体三栏 ── */
.sgw-body { flex-direction: row; flex-grow: 1; }

.sgw-left-pane {
    width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: var(--c-panel-border);
}
.sgw-tab-row { flex-direction: row; }
.sgw-left-tab {
    flex-grow: 1;
    font-size: 11px;
    -unity-font-style: normal;
}
.sgw-left-tab.selected { background-color: rgb(64, 64, 64); }
.sgw-left-content { flex-grow: 1; }

.sgw-graph-container { flex-grow: 1; flex-basis: 0; position: relative; }
.sgw-graph-view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.sgw-inspector-pane {
    width: 300px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: var(--c-panel-border);
}

/* ── 底部运行时监视区 ── */
.sgw-monitor {
    flex-shrink: 0;
    margin-top: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-top-color: var(--c-panel-border);
}
.sgw-monitor.dim { opacity: 0.4; }
.sgw-monitor-title {
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(235, 235, 242);
    background-color: rgb(41, 43, 51);
    padding-left: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 2px;
}
.sgw-monitor-state { font-size: 10px; color: rgb(128, 128, 128); padding-left: 6px; }
.sgw-monitor-line { font-size: 10px; color: rgb(102, 204, 255); padding-left: 6px; padding-top: 2px; }
.sgw-monitor-empty { font-size: 10px; color: rgb(128, 128, 128); }
.sgw-monitor-var { font-size: 10px; }
.sgw-monitor-vars {
    max-height: 130px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 3px;
    background-color: var(--c-inset-bg);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--c-inset-border);
}

/* ── 校验问题面板 ── */
.sgw-validation-foldout { max-height: 200px; }

/* ── 批量操作条（资源 / 角色 / 变量 三处共用）── */
.sgw-bulk-bar {
    flex-direction: column;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(46, 46, 56);
}
.sgw-bulk-top-row { flex-direction: row; align-items: center; margin-bottom: 5px; }
.sgw-bulk-count { color: white; font-size: 11px; }
.sgw-bulk-del-btn { flex-grow: 1; }

/* ── 各面板内通用：标题 / 空态 / 分隔线 / 按钮 / 搜索框 ── */
.sgw-pane-title { -unity-font-style: bold; padding-left: 6px; margin-top: 4px; }
.sgw-pane-empty { color: rgb(128, 128, 128); padding-left: 6px; font-size: 11px; }
.sgw-pane-sep {
    height: 1px;
    background-color: rgb(64, 64, 64);
    margin-top: 8px;
    margin-bottom: 2px;
    margin-left: 6px;
    margin-right: 6px;
}
.sgw-pane-btn { margin-left: 6px; margin-right: 6px; }
.sgw-search-field { margin-top: 4px; margin-left: 6px; margin-right: 6px; flex-grow: 1; }

/* ── 资源树 ── */
.sgw-tree-fold { margin-top: 2px; }
.sgw-tree-toggle { margin-left: 4px; width: 16px; }
.sgw-tree-btn { font-size: 11px; margin-left: 4px; flex-grow: 1; }
.sgw-tree-btn-active { background-color: rgb(64, 64, 64); }

/* ── 角色列表行 ── */
.sgw-char-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-divider);
}
.sgw-char-swatch {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgb(153, 153, 153);
}
.sgw-char-usage { font-size: 10px; color: rgb(128, 128, 128); flex-shrink: 0; }

/* 内联字段（角色名 / 变量名等，占位可收缩进面板） */
.sgw-inline-field { flex-grow: 1; margin-left: 4px; margin-right: 4px; }

/* ── 变量行 ── */
.sgw-var-fold {
    flex-grow: 1;
    min-width: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-divider);
    padding-left: 2px;
    padding-top: 3px;
    padding-bottom: 3px;
}
.sgw-var-header { flex-direction: row; align-items: center; flex-grow: 1; }
.sgw-var-toggle { margin-left: 2px; margin-right: 2px; width: 14px; }
.sgw-var-del { margin-left: 4px; flex-shrink: 0; }
.sgw-type-dot { width: 12px; height: 12px; flex-shrink: 0; margin-right: 6px; }
/* 变量类型色点：颜色取主题变量（原 VarTypeColor 写死 RGB），换配色改 StoryEditorTheme.uss 即可 */
.sgw-type-int    { background-color: var(--c-var-int); }
.sgw-type-float  { background-color: var(--c-var-float); }
.sgw-type-bool   { background-color: var(--c-var-bool); }
.sgw-type-string { background-color: var(--c-var-string); }
.sgw-var-field-row { flex-direction: row; align-items: center; margin-top: 3px; }
.sgw-var-field-label { width: 40px; font-size: 10px; color: rgb(128, 128, 128); flex-shrink: 0; }
.sgw-var-field-ctrl { flex-grow: 1; margin-left: 4px; }

/* ── 属性面板（节点）── */
.sgw-inspector-empty { color: rgb(128, 128, 128); padding-left: 6px; }
.sgw-inspector-header { -unity-font-style: bold; padding-left: 6px; padding-top: 4px; }
.sgw-node-type-label { color: rgb(128, 128, 128); font-size: 11px; padding-left: 6px; }
.sgw-del-btn { margin-top: 8px; }

/* ── 校验问题行（颜色由严重度类决定，主题层 --c-val-* 定义，满足「换配色不改 C#」）── */
.sgw-validation-ok { color: var(--c-val-ok); padding-left: 6px; }
.sgw-validation-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-divider);
}
.sgw-validation-icon { width: 16px; flex-shrink: 0; -unity-font-style: bold; }
.sgw-validation-msg { white-space: normal; flex-grow: 1; }
.sgw-validation-node { color: rgb(128, 128, 128); font-size: 10px; -unity-font-style: italic; margin-left: 4px; }
.sgw-validation-error { color: var(--c-val-error-text); }
.sgw-validation-warning { color: var(--c-val-warning-text); }
.sgw-validation-info { color: rgb(128, 128, 128); }
