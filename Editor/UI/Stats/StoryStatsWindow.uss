/* StoryStatsWindow.uss — 剧情统计面板（02 §4.1） */

.stats-root {
    padding-top: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.stats-section-title {
    -unity-font-style: bold;
    padding-top: 8px;
}

.stats-indent { padding-left: 8px; }

.stats-row { flex-direction: row; }
.stats-key { flex-grow: 1; color: grey; }
